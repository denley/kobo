#!/bin/bash
# Has Lunar Magic save a copy of a ROM, then compares every level of the
# saved copy with the original as Kobo reads them: the Lunar Magic check.
#   save-check rom.sfc [level]     (level: the one LM re-imports, default 105)
# Lunar Magic's restore system wants the original game, with a copier
# header, in sysLMRestore/smwOrig.smc; the vanilla ROM comes from
# KOBO_SMW_ROM or `kobo`'s configuration.
set -euo pipefail
rom=$(realpath "$1"); level=${2:-105}
here=$(dirname "$(realpath "$0")")
kobo=${KOBO:-kobo}
vanilla=${KOBO_SMW_ROM:-$(sed -n 's/^smw *= *"\(.*\)"/\1/p' "${XDG_CONFIG_HOME:-$HOME/.config}/kobo/config.toml")}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir "$work/sysLMRestore"
if [ $(( $(stat -c%s "$vanilla") % 1024 )) -eq 512 ]; then
  cp "$vanilla" "$work/sysLMRestore/smwOrig.smc"
else
  { head -c 512 /dev/zero; cat "$vanilla"; } > "$work/sysLMRestore/smwOrig.smc"
fi
cp "$rom" "$work/saved.smc"
cd "$work"
"$here/lm" -ExportLevel saved.smc level.mwl "$level" >/dev/null
"$here/lm" -ImportLevel saved.smc level.mwl "$level" | tail -1
"$kobo" diff "$rom" saved.smc
